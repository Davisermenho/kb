{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/canonical-artifact.schema.json",
  "title": "Canonical Document Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "source",
    "metadata",
    "content",
    "validation",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "knowledge_document"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "checksum_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "metadata": {
      "title": "Governed Operational Documentation Front Matter",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "type",
        "title",
        "description",
        "status",
        "owner_team",
        "created_at",
        "updated_at",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,80}$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "tutorial",
            "api_reference",
            "policy",
            "runbook",
            "release_note",
            "decision_record",
            "agent_contract",
            "flow",
            "plan"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 280
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "published",
            "deprecated"
          ]
        },
        "owner_team": {
          "type": "string",
          "enum": [
            "docs",
            "platform",
            "security",
            "governance",
            "agents",
            "billing",
            "support"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "api",
              "authentication",
              "oauth2",
              "security",
              "billing",
              "operations",
              "troubleshooting",
              "governance",
              "agent",
              "policy",
              "runbook",
              "plan",
              "flow",
              "release"
            ]
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "approved_by": {
          "type": "string",
          "minLength": 2
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "next_review_at": {
          "type": "string",
          "format": "date"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "published_at": {
          "type": "string",
          "format": "date"
        },
        "release_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target_id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "depends_on",
                  "supersedes",
                  "related_to",
                  "implements",
                  "governs",
                  "derived_from"
                ]
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,80}$"
              }
            }
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "approved_by",
              "approved_at",
              "approval_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "approved_by",
              "approved_at",
              "approval_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "policy"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "effective_date",
              "next_review_at",
              "risk_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "runbook"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "risk_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "release_note"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "published_at",
              "release_version"
            ]
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_markdown",
        "body_text"
      ],
      "properties": {
        "body_markdown": {
          "type": "string",
          "minLength": 1
        },
        "body_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "schema_id",
        "errors"
      ],
      "properties": {
        "valid": {
          "type": "boolean",
          "const": true
        },
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_by",
        "parser_version",
        "generated_at"
      ],
      "properties": {
        "generated_by": {
          "type": "string",
          "const": "conformance-test-pipeline"
        },
        "parser_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
