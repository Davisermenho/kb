{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb.local/schemas/frontmatter.schema.json",
  "title": "Front Matter General Envelope Schema",
  "description": "Contrato geral do envelope de Front Matter para documentos governados. Este schema consolida decisões já registradas no FIELD_REGISTRY.md, MATRIZ_DECISAO_CAMPOS_FRONTMATTER, DECISAO_001 e PLANO_FRONT_MATTER. Não valida campos específicos de tipo documental e não inclui campos derivados pelo pipeline.",
  "type": "object",
  "additionalProperties": true,
  "$comment": "Este schema implementa apenas campos existentes no FIELD_REGISTRY.md. Campos gerais aprovados e condicionais entram como validação positiva. Campos técnicos ou derivados registrados como pipeline-only/derived_only aparecem somente como bloqueio explícito no YAML manual. additionalProperties permanece true nesta versão para permitir composição posterior com schemas específicos por tipo; campos desconhecidos e políticas cross-file devem ser tratados por pipeline complementar até a composição final.",

  "required": [
    "id",
    "schema_version",
    "type",
    "title",
    "description",
    "status",
    "owner_team",
    "version",
    "ai_usage_policy"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "description": "Identificador estável do documento governado."
    },

    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Versão do contrato de Front Matter usada para validação."
    },

    "type": {
      "type": "string",
      "enum": [
        "tutorial",
        "api_reference",
        "policy",
        "runbook",
        "release_note",
        "plan",
        "decision_record",
        "agent_contract",
        "flow",
        "domain_knowledge"
      ],
      "description": "Tipo documental usado para roteamento de schema específico, template, validação e agentes."
    },

    "title": {
      "type": "string",
      "minLength": 3
    },

    "description": {
      "type": "string",
      "minLength": 20
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "published",
        "deprecated",
        "archived"
      ]
    },

    "owner_team": {
      "type": "string",
      "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
    },

    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "ai_usage_policy": {
      "type": "string",
      "enum": [
        "reference_only",
        "human_review_required",
        "do_not_use",
        "executable_instruction"
      ],
      "default": "reference_only"
    },

    "approved_by": {
      "type": "string",
      "minLength": 3
    },

    "approved_at": {
      "$ref": "#/$defs/isoDate"
    },

    "approval_ref": {
      "$ref": "#/$defs/approvalRef"
    },

    "published_at": {
      "$ref": "#/$defs/isoDate"
    },

    "effective_from": {
      "$ref": "#/$defs/isoDate"
    },

    "last_reviewed_at": {
      "$ref": "#/$defs/isoDate"
    },

    "decision_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decisionRef"
      },
      "uniqueItems": true,
      "minItems": 1
    },

    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      },
      "uniqueItems": true,
      "minItems": 1
    },

    "provenance_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenanceRef"
      },
      "uniqueItems": true,
      "minItems": 1
    },

    "created_at": false,
    "updated_at": false,
    "sys_created_at": false,
    "sys_updated_at": false,
    "content_hash": false,
    "compiled_at": false,
    "compiled_by": false
  },

  "allOf": [
    {
      "$comment": "Aprovação obrigatória para documentos approved ou published.",
      "if": {
        "properties": {
          "status": {
            "enum": ["approved", "published"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": [
          "approved_by",
          "approved_at",
          "approval_ref",
          "last_reviewed_at"
        ]
      }
    },
    {
      "$comment": "Publicação exige data de publicação.",
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["published_at"]
      }
    },
    {
      "$comment": "Documentos aprovados/publicados com efeito operacional exigem data de vigência.",
      "if": {
        "properties": {
          "status": {
            "enum": ["approved", "published"]
          },
          "type": {
            "enum": [
              "policy",
              "runbook",
              "agent_contract",
              "decision_record",
              "flow"
            ]
          }
        },
        "required": ["status", "type"]
      },
      "then": {
        "required": ["effective_from"]
      }
    },
    {
      "$comment": "Status draft não deve carregar aprovação ativa salvo migração/histórico tratado pelo pipeline.",
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["approved_by"] },
            { "required": ["approved_at"] },
            { "required": ["approval_ref"] },
            { "required": ["published_at"] }
          ]
        }
      }
    }
  ],

  "$defs": {
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Data ISO 8601 no formato YYYY-MM-DD."
    },

    "approvalRef": {
      "type": "string",
      "pattern": "^APR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },

    "decisionRef": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },

    "sourceRef": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },

    "provenanceRef": {
      "type": "string",
      "pattern": "^PROV-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    }
  }
}
